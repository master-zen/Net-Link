#!name=Ximalaya AD Blacklist
#!desc=V1.0.0 - Ximalaya splash, feed, banner and player ad filtering.
#!version=1.0.0
#!category=Advertising

[Rule]
DOMAIN,ad.test.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adbehavior.wsa.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adbehavior.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adbs.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adse.test.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adwbs.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adweb.test.ximalaya.com,REJECT,extended-matching,pre-matching
DOMAIN,adweb.ximalaya.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/api/v[0-9]+/adRealTime(?:/[^?#]*)?(?:\?[^#]*)?$ _ reject
^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/discovery-feed/isShowUserGiftPendant/?(?:\?[^#]*)?$ _ reject

[Map Local]
^https?://(?:adse(?:\.wsa)?|adsehera)\.ximalaya\.com(?::(?:80|443))?/ting(?:/feed)?(?:/ts-[0-9]+)?/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/business-sale-promotion-guide-mobile-web/popup(?:/[^?#]*)?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
ximalaya.ad-loading = type=http-response,pattern=^https?://(?:adse(?:\.wsa)?|adsehera)\.ximalaya\.com(?::(?:80|443))?/ting/loading(?:/ts-[0-9]+)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.ad-slots = type=http-response,pattern=^https?://(?:adse(?:\.wsa)?|adsehera)\.ximalaya\.com(?::(?:80|443))?/adx/ad(?:/ts-[0-9]+)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.feed = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/discovery-feed/v[0-9]+/mix(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.focus = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/focus-mobile/focusPic(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.category = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/discovery-category/v[0-9]+/category(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.portal = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/football-portal/diff2/batch/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.player = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/mobile-playpage/playpage/tabs/v[0-9]+(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.profile = type=http-response,pattern=^https?://(?:mobile|mobilehera|mobwsa)\.ximalaya\.com(?::(?:80|443))?/mobile-user/v[0-9]+/homePage(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
ximalaya.guide = type=http-response,pattern=^https?://(?:search|searchwsa)\.ximalaya\.com(?::(?:80|443))?/hub/guideWordV[0-9]+(?:/[^?#]*)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/ximalaya-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15

[MITM]
hostname = %APPEND% adse.wsa.ximalaya.com, adse.ximalaya.com, adsehera.ximalaya.com, mobile.ximalaya.com, mobilehera.ximalaya.com, mobwsa.ximalaya.com, search.ximalaya.com, searchwsa.ximalaya.com
