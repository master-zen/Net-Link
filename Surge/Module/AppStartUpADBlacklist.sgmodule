[Rule]
DOMAIN,splashimgbssdl.yun.kugou.com,REJECT
DOMAIN,splashimgretrybssdl.cloud.kugou.com,REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,pre.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,iacc.stgw.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,tacc.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

