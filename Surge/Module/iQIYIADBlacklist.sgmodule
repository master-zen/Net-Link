#!name=iQIYI AD Blacklist
#!desc=V1.0.0 - iQIYI splash, mixer ad slots and scoped advertising cards.
#!version=1.0.0
#!category=Advertising

[Rule]
DOMAIN,ad.m.iqiyi.com,REJECT,extended-matching,pre-matching
DOMAIN,afp.iqiyi.com,REJECT,extended-matching,pre-matching
DOMAIN,iqiyim.adtrack.enlightent.cn,REJECT,extended-matching,pre-matching

[Script]
iqiyi.mixer = type=http-response,pattern=^https?://(?:kjp|t7z)\.cupid\.iqiyi\.com/mixer(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.home = type=http-response,pattern=^https?://(?:cards\.iqiyi\.com|access\.if\.iqiyi\.com/3f1/cards\.iqiyi\.com|(?:[0-9]{1,3}\.){3}[0-9]{1,3}/3f1/cards\.iqiyi\.com)/views_home/3\.0/qy_home(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.category = type=http-response,pattern=^https?://(?:cards\.iqiyi\.com|access\.if\.iqiyi\.com/3f1/cards\.iqiyi\.com|(?:[0-9]{1,3}\.){3}[0-9]{1,3}/3f1/cards\.iqiyi\.com)/views_category/3\.0/(?:category_home|categorylib_content|film_hybrid)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.feed = type=http-response,pattern=^https?://(?:cards\.iqiyi\.com|access\.if\.iqiyi\.com/3f1/cards\.iqiyi\.com|(?:[0-9]{1,3}\.){3}[0-9]{1,3}/3f1/cards\.iqiyi\.com)/waterfall(?:-plt)?/3\.0/feed(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.player = type=http-response,pattern=^https?://cards\.iqiyi\.com/views_plt/3\.0/player_tabs_v2(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.search = type=http-response,pattern=^https?://cards\.iqiyi\.com/views_search/3\.0/(?:hot_query_)?search(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.comments = type=http-response,pattern=^https?://comment-card\.iqiyi\.com/views_comment/3\.0/long_video_comments(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10
iqiyi.config = type=http-response,pattern=^https?://iface2\.iqiyi\.com/fusion/3\.0/common_switch(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/iqiyi-ad.js?v=1.0.0,requires-body=true,max-size=4194304,timeout=10

[MITM]
hostname = %APPEND% access.if.iqiyi.com, cards.iqiyi.com, comment-card.iqiyi.com, iface2.iqiyi.com, kjp.cupid.iqiyi.com, t7z.cupid.iqiyi.com
