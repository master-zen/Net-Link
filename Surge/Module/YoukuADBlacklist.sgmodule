#!name=Youku AD Blacklist
#!desc=V1.0.0 - Youku splash, video ad data and scoped feed filtering.
#!version=1.0.0
#!category=Advertising
#!icon=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Icon/Youku.png

[Rule]
DOMAIN,ad.api.3g.tudou.com,REJECT,extended-matching,pre-matching
DOMAIN,ad.api.3g.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,ad.api.mobile.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,ad.mobile.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,adx-core.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,adx-open-service.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,cad.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,yk-ssp.ad.youku.com,REJECT,extended-matching,pre-matching
DOMAIN,ykad-data.youku.com,REJECT,extended-matching,pre-matching

[Map Local]
^https?://acs\.youku\.com/gw/mtop\.youku\.xspace\.poplayer\.position\.query(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
youku.startup = type=http-response,pattern=^https?://un-acs\.youku\.com/gw/mtop\.youku\.play\.ups\.appinfo\.get(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.popup = type=http-response,pattern=^https?://push\.m\.youku\.com/collect-api/get_push_interval_config_wx/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.detail = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.columbus\.gateway\.new\.execute(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.feed = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.columbus\.home\.feed(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.channel = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.columbus\.home\.query(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.profile = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.columbus\.uc\.query(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.comments = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.columbus\.ycp\.query(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
youku.search = type=http-response,pattern=^https?://acs\.youku\.com/gw/mtop\.youku\.soku\.yksearch(?:/[0-9]+(?:\.[0-9]+)*)?/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/youku-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15

[MITM]
hostname = %APPEND% acs.youku.com, push.m.youku.com, un-acs.youku.com
