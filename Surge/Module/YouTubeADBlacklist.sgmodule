#!name=YouTube AD Blacklist
#!desc=YouTube and YouTube Music ads, background playback, Shorts and Playables; upstream core with local supplement.
#!category=Advertising
#!arguments=WorkerMode:false,LocalFallback:true
#!arguments-desc=WorkerMode sends playback key and URL to Maasea's external Worker when matched; opt in only. LocalFallback attempts native player fallback; disable if playback stalls.
#!icon=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Icon/YouTube.png

[Rule]
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,music.youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT

[Map Local]
^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$ data-type=text data="" status-code=200
^https:\/\/(?:www|s)\.youtube\.com\/(?:api\/stats\/ads|pagead)(?:[/?][^#]*)?$ data-type=text data="" status-code=200
^https:\/\/[\w-]+\.googlevideo\.com\/dclk_video_ads(?:[/?][^#]*)?$ data-type=text data="" status-code=200

[Script]
youtube.ad.response = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=-1,timeout=60,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/youtube-integrated.js?v=7,argument="{\"worker\":{{{WorkerMode}}},\"fallback\":{{{LocalFallback}}}}"
youtube.ad.init = type=http-request,pattern=^https:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=[^&#]*)?(?:&[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=-1,timeout=20,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/youtube-integrated.js?v=7,argument="{\"worker\":{{{WorkerMode}}},\"fallback\":{{{LocalFallback}}}}"
youtube.ad.log = type=http-request,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/log_event(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=-1,timeout=20,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/youtube-integrated.js?v=7,argument="{\"worker\":{{{WorkerMode}}},\"fallback\":{{{LocalFallback}}}}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, music.youtube.com, www.youtube.com, s.youtube.com
