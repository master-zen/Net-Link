[Script]
知道搜索广告(zhidao.baidu.com) = type=http-response , pattern="^https?:\/\/(zhidao)\.baidu\.com\/(question|index|\?fr|\?word)" , requires-body=1 , max-size=-1 , script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/Adblock4limbo.js , script-update-interval=86400
搜索首页广告(www.baidu.com) = type=http-response , pattern="https?:\/\/(www|m)\.baidu\.com(/$|\/\?ref.*)" , requires-body=1 , max-size=-1 , script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/Adblock4limbo.js , script-update-interval=86400
搜索结果广告(www.baidu.com) = type=http-response , pattern="https?:\/\/(www|m)\.baidu\.com\/(from=|s\?)" , requires-body=1 , max-size=-1 , script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Scripts/Adblock4limbo.js , script-update-interval=86400
