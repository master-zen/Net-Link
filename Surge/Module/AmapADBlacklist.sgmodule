#!name=Amap AD Blacklist
#!desc=V1.1.0 - Amap splash, search and navigation advertising filters.
#!version=1.1.0
#!category=Advertising

[Rule]
DOMAIN,optimus-ads.amap.com,REJECT,extended-matching,pre-matching
DOMAIN,optimus-ads.amap.com.w.alikunlun.com,REJECT,extended-matching,pre-matching

[URL Rewrite]
^https?://amap-aos-info-nogw\.amap\.com/ws/aos/alimama/splash_screen_rt/?(?:\?[^#]*)?$ _ reject
^https?://amap-aos-info-nogw\.amap\.com/ws/aos/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m0\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m1\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m2\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m3\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m4\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m5\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m6\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m7\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m8\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject
^https?://m9\.amap\.com/ws/valueadded/alimama/splash_screen/?(?:\?[^#]*)?$ _ reject

[Map Local]
^https?://m0\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m1\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m2\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m3\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m4\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m5\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m6\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m7\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m8\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m9\.amap\.com/ws/shield/dsp/app/startup/init/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://m5\.amap\.com/ws/shield/search_poi/tips_adv(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://oss\.amap\.com/ws/banner/lists/(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
amap.drive = type=http-response,pattern=^https?://m5\.amap\.com/ws/perception/drive/(?:routeInfo|routePlan)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.bus = type=http-response,pattern=^https?://m5\.amap\.com/ws/bus/plan/integrate(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.marketing = type=http-response,pattern=^https?://m5\.amap\.com/ws/shield/search_business/process/marketingOperationStructured(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.suggest = type=http-response,pattern=^https?://m5\.amap\.com/ws/shield/search_poi/sug(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.search = type=http-response,pattern=^https?://m5\.amap\.com/ws/shield/search_poi/(?:mps|search/sp)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.detail = type=http-response,pattern=^https?://(?:info|m5)\.amap\.com/ws/shield/search/poi/detail(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.tips = type=http-response,pattern=^https?://m5\.amap\.com/ws/shield/search_poi/tips_operation_location(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.home = type=http-response,pattern=^https?://m5\.amap\.com/ws/faas/amap-navigation/(?:main-page|card-service-plan-home)(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.profile = type=http-response,pattern=^https?://m5\.amap\.com/ws/shield/dsp/profile/index/nodefaasv3(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.taxi = type=http-response,pattern=^https?://m5-zb\.amap\.com/ws/boss/car/order/content_info(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.taxipromo = type=http-response,pattern=^https?://m5-zb\.amap\.com/ws/promotion-web/resource(?:/home)?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.hotel = type=http-response,pattern=^https?://m5\.amap\.com/ws/c3frontend/af-hotel/page/main(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
amap.config-m0 = type=http-response,pattern=^https?://m0\.amap\.com/ws/shield/frogserver/aocs/updatable/1/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/amap-ad.js?v=1.1.0,requires-body=true,max-size=8388608,timeout=15
