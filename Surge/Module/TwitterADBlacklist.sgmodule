#!name=Twitter AD Blacklist
#!desc=V1.0.0 - X/Twitter web timeline and conversation ads; native app domain filtering only.
#!version=1.0.0
#!category=Advertising

[Rule]
DOMAIN-SUFFIX,ads-twitter.com,REJECT

[Script]
twitter.ad.response = type=http-response,pattern=^https:\/\/(?:x|twitter)\.com\/i\/api\/graphql\/[A-Za-z0-9_-]+\/(?:HomeTimeline|HomeLatestTimeline|TweetDetail)(?:\?[^#]*)?$,requires-body=true,binary-body-mode=false,max-size=16777216,timeout=15,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/twitter-ad.js?v=1

[MITM]
hostname = %APPEND% x.com, twitter.com
