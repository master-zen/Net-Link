#!name=Xiaohongshu AD Blacklist
#!desc=V1.0.0 - Xiaohongshu splash, sponsored feed and promotional popup filtering.
#!version=1.0.0
#!category=Advertising

[Rule]
DOMAIN,ads-img-al.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-img-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-al.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-video-qc.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,ads-vp5.xhscdn.com,REJECT,extended-matching,pre-matching
DOMAIN,t-ads.xiaohongshu.com,REJECT,extended-matching,pre-matching

[Map Local]
^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/surprisebox/(?:get_style|open)/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://www\.(?:xiaohongshu|rnote)\.com/api/marketing/box/trigger/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?://www\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/ads/resource/?(?:\?[^#]*)?$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
xiaohongshu.splash-cn = type=http-response,pattern=^https?://edith\.xiaohongshu\.com/api/sns/v[0-9]+/system_service/splash_config(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=1048576,timeout=15
xiaohongshu.splash-rnote = type=http-response,pattern=^https?://edith\.rnote\.com/api/sns/v[0-9]+/system_service/splash_config(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=1048576,timeout=15
xiaohongshu.startup-config = type=http-response,pattern=^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/system_service/config/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.splash-slash = type=http-response,pattern=^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/system_service/splash_config/(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.splash-legacy = type=http-response,pattern=^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/system_service/splash/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.home = type=http-response,pattern=^https?://(?:edith|rec)\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/homefeed/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.follow = type=http-response,pattern=^https?://(?:edith|rec)\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/(?:followfeed|user/followings/followfeed)/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.video = type=http-response,pattern=^https?://(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/note/videofeed/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.search = type=http-response,pattern=^https?://(?:edith|so)\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/search/notes/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.search-promo = type=http-response,pattern=^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/search/(?:banner_list|hot_list|hint|trending)/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15
xiaohongshu.widgets = type=http-response,pattern=^https?://edith\.(?:xiaohongshu|rnote)\.com/api/sns/v[0-9]+/note/widgets/?(?:\?[^#]*)?$,script-path=https://raw.githubusercontent.com/master-zen/Net-Link/main/Surge/Module/runtime/xiaohongshu-ad.js?v=1.0.0,requires-body=true,max-size=8388608,timeout=15

[MITM]
hostname = %APPEND% edith.rnote.com, edith.xiaohongshu.com, rec.rnote.com, rec.xiaohongshu.com, so.rnote.com, so.xiaohongshu.com, www.rnote.com, www.xiaohongshu.com
